# --- Admin auth ---
# The single password used to log in at /admin.
ADMIN_PASSWORD=change-me
# Secret used to sign the session cookie (any long random string).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# --- Content storage (Upstash Redis) ---
# Provided automatically when you add the Upstash Redis integration on Vercel.
# If these are absent (e.g. local dev), content falls back to a local .data/content.json file.
KV_REST_API_URL=
KV_REST_API_TOKEN=
